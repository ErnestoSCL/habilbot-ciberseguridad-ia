# Copiar a .env y completar. El archivo .env nunca se sube al repositorio ni se comparte.

# Proveedor del modelo de lenguaje: "openai", "gemini" o "simulado" (sin API, para pruebas).
# Si se deja vacío, se usa el proveedor cuya llave esté completa.
# El agente (emisión de constancias) solo funciona con "openai": usa su interfaz de herramientas.
# Con "gemini" responde el asistente, pero el agente no; "simulado" sirve para las pruebas.
LLM_PROVEEDOR=

OPENAI_API_KEY=
OPENAI_MODELO=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash
