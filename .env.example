# Copiar a .env y completar. El archivo .env nunca se sube al repositorio.

# Proveedor del modelo de lenguaje: "openai", "gemini" o "simulado" (sin API, para pruebas).
# Si se deja vacío, se usa el proveedor cuya llave esté completa.
LLM_PROVEEDOR=

OPENAI_API_KEY=
OPENAI_MODELO=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash
